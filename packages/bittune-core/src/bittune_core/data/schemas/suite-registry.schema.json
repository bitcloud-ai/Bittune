{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bittune-suite-registry-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "concurrency_mode",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "concurrency_mode": {
      "enum": [
        "ladder",
        "adaptive"
      ]
    },
    "min_probe": {
      "type": "integer",
      "minimum": 1
    },
    "max_probe": {
      "type": "integer",
      "minimum": 1
    },
    "min_free_memory_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "stability": {
      "$ref": "#/$defs/stability"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_points",
        "max_requests",
        "max_duration_seconds",
        "max_artifact_bytes"
      ],
      "properties": {
        "max_points": {
          "type": "integer",
          "minimum": 1
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "input_tokens",
        "output_tokens",
        "concurrency",
        "request_count",
        "closed_loop",
        "stream",
        "ignore_eos",
        "temperature",
        "seed",
        "warmup_requests",
        "request_timeout_seconds"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "scenario": {
          "enum": [
            "chat",
            "rag",
            "batch",
            "coding"
          ]
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "request_count": {
          "type": "integer",
          "minimum": 1
        },
        "closed_loop": {
          "type": "boolean"
        },
        "stream": {
          "type": "boolean"
        },
        "ignore_eos": {
          "type": "boolean"
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer"
        },
        "warmup_requests": {
          "type": "integer",
          "minimum": 0
        },
        "request_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "prefix_length": {
          "type": "integer",
          "minimum": 0
        },
        "destructive": {
          "type": "boolean"
        },
        "representative": {
          "type": "boolean"
        }
      }
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "repeats",
        "request_count",
        "concurrency"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "repeats": {
          "type": "integer",
          "minimum": 1
        },
        "request_count": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "budget"
        ]
      },
      "else": {
        "not": {
          "required": [
            "budget"
          ]
        }
      }
    }
  ]
}
