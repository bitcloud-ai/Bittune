{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/bittune-capabilities/**/*.ts",
    "packages/bittune-runtime/src/bittune.ts",
    "packages/bittune-runtime/src/shims.d.ts",
    "tests/**/*.test.ts"
  ]
}
